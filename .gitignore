.DS_Store

# Captures brutes envoyées depuis le téléphone (WhatsApp, etc.).
# Les visuels réellement utilisés sont traités et versionnés dans landing/img/.
# Ce dossier reste local : c'est un dépôt de travail, pas un asset du produit.
assets/screenshots mobile app/

# Avatar sources: the 1024² renders (14 MB) the 256² bundled sprites come from.
# Kept locally so they can be re-exported at another size; never committed and
# never bundled — only the sprites in assets/avatars/ are required by the code.
assets/avatars/source/

# Dépôt temporaire des photos produit : seules les images traitées sont versionnées.
assets/images/products/_incoming/*
!assets/images/products/_incoming/README.md

.vercel
.env*

# Captures brutes du téléphone : seules les versions optimisées sont versionnées.
landing/public/screens/_incoming/*
!landing/public/screens/_incoming/.gitkeep
